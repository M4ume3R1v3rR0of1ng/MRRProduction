<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Steadwerk</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Export compliance, declared here so an upload does not stall waiting for
	     a human. Without this key every build that lands in App Store Connect
	     sits in "Missing Compliance" until someone opens the web UI and answers
	     the encryption questionnaire by hand — which would make the automated
	     TestFlight job in .github/workflows/ios-build.yml only half an
	     automation.

	     false is the correct answer, not a convenient one. The app ships no
	     cryptography of its own: it talks HTTPS to Supabase, Netlify and APNs,
	     and uses the platform's TLS to do it. That is the standard exemption
	     under category 5, part 2 of the U.S. Export Administration Regulations.
	     If the app ever bundles its own crypto — on-device encryption of cached
	     job data, say — this has to be revisited, because the declaration is a
	     legal statement and not a build setting. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- REQUIRED by @capacitor/camera. iOS does not fail politely when a usage
	     string is missing: the moment code touches the camera or the photo
	     library the system TERMINATES the app, with no JavaScript error and
	     nothing in the webview console. It reads as a random crash.

	     This text is shown verbatim in the permission dialog, so it says what
	     the photo is for rather than asking for access in the abstract. Apple
	     also rejects vague or boilerplate strings under Guideline 5.1.1. -->
	<key>NSCameraUsageDescription</key>
	<string>Steadwerk uses the camera to attach photos to jobs, vehicle inspections and maintenance requests.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Steadwerk lets you attach photos you have already taken to jobs, vehicle inspections and maintenance requests.</string>
	<!-- REQUIRED by @capacitor/push-notifications. Unlike the camera, iOS does
	     not require a usage-description string for the push permission prompt
	     itself — but background-mode remote notifications (a push arriving
	     while the app isn't in the foreground) are opt-in per capability, and
	     this is how the app declares it wants them. Without this key, a push
	     sent while the app is closed/backgrounded may not reliably wake
	     processing of it. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
