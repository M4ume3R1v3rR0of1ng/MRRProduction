# Copy to .env and fill in. NEVER commit the filled-in file.
#
# Deployed builds read all of this from the Netlify environment (Site settings →
# Environment variables). Only local `netlify dev` needs a file on disk, so a key
# missing here does not mean production is missing it — check Netlify before
# concluding anything is broken.
#
# VITE_-prefixed vars are inlined into the client bundle and are PUBLIC by design.
# Everything else is server-only and reaches nothing but the Netlify functions.
# Putting a secret behind a VITE_ prefix ships it to every browser that loads the
# app, so the prefix is a security boundary, not a naming convention.

# ── Supabase ────────────────────────────────────────────────────────────────
# Both of these are public: the anon key is shipped in the bundle and is governed
# entirely by the RLS policies in supabase/.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key from Supabase → Settings → API>

# THE key that matters. Bypasses every RLS policy in supabase/ completely. Only
# the Netlify functions ever hold it, and _shared/tenant.js is what stops a
# function from reading another company's rows. Note the functions read the URL
# from VITE_SUPABASE_URL above rather than a separate server-side copy.
SUPABASE_SERVICE_ROLE_KEY=<service_role key from Supabase → Settings → API>

# ── Stripe ──────────────────────────────────────────────────────────────────
# Read by create-checkout, add-seats, billing-portal and stripe-webhook.
STRIPE_SECRET_KEY=sk_test_...

# The four Prices the app bills. Their amounts must match the numbers displayed in
# LandingPage.jsx and LoginScreen.jsx — a page that advertises terms checkout does
# not honor is a refund request waiting to happen.
#   BASE            $99/mo, includes 10 users
#   ANNUAL          $990/yr prepay, the "2 months free" option
#   SEAT_PACK       +$10/mo per additional block of 5 users
#   SEAT_PACK_ANNUAL  the annual equivalent of a seat pack
STRIPE_BASE_PRICE_ID=price_...
STRIPE_ANNUAL_PRICE_ID=price_...
STRIPE_SEAT_PACK_PRICE_ID=price_...
STRIPE_SEAT_PACK_ANNUAL_PRICE_ID=price_...

# Only needed to verify webhook signatures. For local dev, `stripe listen
# --forward-to localhost:8888/.netlify/functions/stripe-webhook` prints one.
# Without it stripe-webhook rejects every delivery, so seat capacity and
# subscription state stop updating.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Read by create-user, send-alert and send-email.
RESEND_API_KEY=re_...

# Optional. The verified sending domain all platform mail goes out from. Defaults
# to steadwerk.com when unset, which is the right fallback — see
# platformFromAddress() in netlify/functions/_shared/tenant.js.
#   PLATFORM_MAIL_DOMAIN  the bare domain, e.g. "steadwerk.com" (preferred)
#   PLATFORM_MAIL_FROM    legacy full address; only its domain is used
# PLATFORM_MAIL_DOMAIN=steadwerk.com
# PLATFORM_MAIL_FROM=notifications@steadwerk.com

# ── AccuLynx ────────────────────────────────────────────────────────────────
# Per-company keys live in companies.integrations, set from Settings → Integrations.
# This env var is the fallback for the machine-to-machine import path only.
ACCULYNX_API_KEY=<AccuLynx API key>

# Shared secret for the acculynx-import endpoint, sent as the `x-import-secret`
# header. There is no user session on that endpoint, so this is the only thing
# authenticating it. If unset the endpoint returns 401 to everyone, which is the
# correct fail-closed behaviour. Generate any long random string.
ACCULYNX_IMPORT_SECRET=<long random string>

# ── Anthropic ───────────────────────────────────────────────────────────────
# Read by chat.js, which backs the in-app assistant.
ANTHROPIC_API_KEY=sk-ant-...

# ── App URL ─────────────────────────────────────────────────────────────────
# Where Stripe sends people back after checkout and after the billing portal.
# Netlify sets `URL` automatically on deployed sites, and both functions fall back
# to https://steadwerk.com, so this is only worth setting for local dev.
# PUBLIC_APP_URL=http://localhost:8888

# ── Feature flags ───────────────────────────────────────────────────────────
# Google sign-in. The button and the redirect-return handling are already built,
# but the provider needs an OAuth client created in Google Cloud Console and
# pasted into Supabase → Authentication → Providers first. Until that exists
# Supabase answers "Unsupported provider" and the button would be a dead control,
# so it stays hidden. Set to the string "true" once the provider is live.
# VITE_GOOGLE_AUTH_ENABLED=false
