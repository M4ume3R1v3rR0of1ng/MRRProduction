    "@sentry/node": "^10.73.0",
    "@sentry/react": "^10.73.0",
    "@supabase/supabase-js": "^2.106.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.3",
    "resend": "^6.12.4",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
