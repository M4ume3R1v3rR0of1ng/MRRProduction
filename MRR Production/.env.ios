# Loaded by `vite build --mode ios` (see the build:ios script in package.json).
#
# This file is COMMITTED on purpose and holds no secrets. It exists so the App
# Store build is reproducible from a clean checkout, including on a CI macOS
# runner that has none of your local environment.
#
# It is additive: Vite loads .env first and then .env.ios on top, so the Supabase
# URL and anon key still come from wherever they normally do. Only the platform
# marker is set here.
#
# What this switches off is described in full in src/utils/platform.js. In short:
# the iOS app is a sign-in-only client with no pricing, no signup and no checkout,
# because Apple requires In-App Purchase for anything a user can buy in-app and
# that would take 15-30% of a $99/month B2B subscription.
VITE_APP_PLATFORM=ios
